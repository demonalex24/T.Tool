{
  "name": "t-tool-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "世界树工程 T.Tool · 本地离线创作工作台",
  "author": "T.Tool",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --x64 --dir && node scripts/package-zip.mjs",
    "verify": "node scripts/verify-storage.mjs && tsx scripts/verify-model.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "41.0.2",
    "electron-builder": "26.0.12",
    "playwright": "1.58.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "local.ttool.worldtree",
    "productName": "世界树工程 T.Tool",
    "directories": {
      "output": "release/1.1.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "T.Tool-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "世界树工程 T.Tool",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "T.Tool-${version}-${arch}-portable.${ext}"
    }
  }
}
